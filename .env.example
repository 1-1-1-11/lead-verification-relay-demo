# Copy to .env and edit locally. .env is gitignored.
# Values already exported in the shell win over this file.
# Do not put real customer data, tokens, or sheet IDs here.

# Listen address used by `python -m relay_demo`.
# This demo has no authentication. Keep it on localhost.
RELAY_HOST=127.0.0.1
RELAY_PORT=8017

# Where the bounded event log is written. Created on startup.
RELAY_DATA_DIR=./data

# Claim size. DEFAULT must be <= MAX. The API rejects sizes outside 1..MAX.
RELAY_DEFAULT_BATCH_SIZE=3
RELAY_MAX_BATCH_SIZE=5

# Event log rotation. Size is UTF-8 bytes; backups are relay-events.jsonl.1, .2, ...
RELAY_EVENT_LOG_MAX_BYTES=2097152
RELAY_EVENT_LOG_BACKUPS=3

# Refuse new claims when the in-process heartbeat is older than this many seconds.
RELAY_MONITOR_MAX_LAG_SECONDS=15

# Where `python -m relay_demo.demo_flow` sends HTTP requests.
RELAY_BASE_URL=http://127.0.0.1:8017
